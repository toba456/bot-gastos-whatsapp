# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_VERIFY_TOKEN=elegi-una-palabra-secreta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Google Sheets (service account con acceso Editor a la planilla)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Vercel AI Gateway (para llamar a Gemini). En local se resuelve solo con el
# VERCEL_OIDC_TOKEN que genera `vercel link` / `vercel dev` (no hace falta
# esta variable a mano). Completala solo si corres fuera de Vercel.
AI_GATEWAY_API_KEY=

# Numero del dueno del bot, con codigo de pais y SIN el "+" (a este numero
# responde siempre el bot, y a este se le manda el resumen automatico de fin
# de mes). Para numeros de Argentina, usar el formato de marcado LOCAL (con
# "15", sin el "9"): ver la seccion "Numeros de Argentina" del README.
WHATSAPP_OWNER_NUMBER=

# Secreto para autenticar las llamadas del cron de Vercel al endpoint de
# resumen mensual. Generalo vos, ej: `openssl rand -hex 20`.
CRON_SECRET=
